# OpenAI-compatible API / MLX
GEMMA4_MODEL=mlx-community/gemma-4-e4b-it-4bit
GEMMA4_API_MODEL_ID=gemma-4-e4b-it
QWEN_MODEL=mlx-community/Qwen3.6-14B-4bit
QWEN_API_MODEL_ID=qwen-3.6-14b-it
BONSAI_MODEL=prism-ml/Ternary-Bonsai-8B-mlx-2bit
BONSAI_API_MODEL_ID=bonsai-8b-2bit
GEMMA4_MTP_ENABLED=false
GEMMA4_DRAFT_MODEL=mlx-community/gemma-4-E4B-it-assistant-bf16
GEMMA4_DRAFT_KIND=mtp
GEMMA4_DRAFT_BLOCK_SIZE=6
LOCAL_LLM_GPU_SAFE_MODE=true
LOCAL_LLM_PREFILL_STEP_SIZE=2048
GEMMA4_PREFILL_STEP_SIZE=2048
LOCAL_LLM_CONTEXT_WINDOW=176000
LOCAL_LLM_MAX_PROMPT_TOKENS=160000
LOCAL_LLM_MAX_OUTPUT_TOKENS=20000
LOCAL_LLM_MAX_TOOL_CALL_TOKENS=20000
GEMMA4_API_HOST=0.0.0.0
GEMMA4_API_PORT=44448
LOCAL_LLM_DAEMON_PRELOAD=true
LOCAL_LLM_DAEMON_REQUEST_TIMEOUT_MS=900000

# Ollama Configuration (optional)
OLLAMA_HOST=http://localhost:11434

# Tool Configuration
BRAVE_SEARCH_API_KEY=your_api_key_here

# Embedding Configuration
EMBEDDING_API_HOST=127.0.0.1
EMBEDDING_API_PORT=44512
EMBEDDING_MODEL_DIR=embedding/models/multilingual-e5-small

# Qwen3 Speech daemons (TTS / ASR)
SPEECH_DATA_ROOT=
QWEN3_TTS_HOST=127.0.0.1
QWEN3_TTS_PORT=44520
QWEN3_TTS_QUEUE_SIZE=8
QWEN3_TTS_TIMEOUT_SECONDS=300
QWEN3_TTS_PRELOAD=true
QWEN3_TTS_WARMUP=true
QWEN3_TTS_SECONDARY_KEEPALIVE_SECONDS=600
QWEN3_ASR_HOST=127.0.0.1
QWEN3_ASR_PORT=44521
QWEN3_ASR_QUEUE_SIZE=8
QWEN3_ASR_TIMEOUT_SECONDS=300
QWEN3_ASR_PRELOAD=true
QWEN3_ASR_WARMUP=true
QWEN3_ASR_SSE_ACCURATE_FINAL=true
